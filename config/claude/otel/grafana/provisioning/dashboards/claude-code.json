{
  "title": "Claude Code",
  "uid": "claude-code-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Cost · official",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_claude_code_cost_usage_USD_total[$__range]))",
          "legendFormat": "Total Cost",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Token Usage by Type",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum(claude_code_claude_code_token_usage_tokens_total{type=\"input\"})",
          "legendFormat": "Input",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(claude_code_claude_code_token_usage_tokens_total{type=\"output\"})",
          "legendFormat": "Output",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(claude_code_claude_code_token_usage_tokens_total{type=\"cacheRead\"})",
          "legendFormat": "Cache Read",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(claude_code_claude_code_token_usage_tokens_total{type=\"cacheCreation\"})",
          "legendFormat": "Cache Creation",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Token Usage by Model",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_claude_code_token_usage_tokens_total[$__rate_interval]))",
          "legendFormat": "{{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(claude_code_claude_code_token_usage_tokens_total{type=\"cacheRead\"}) / (sum(claude_code_claude_code_token_usage_tokens_total{type=\"cacheRead\"}) + sum(claude_code_claude_code_token_usage_tokens_total{type=\"input\"}))",
          "legendFormat": "Cache Hit Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Cost by Model Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_claude_code_cost_usage_USD_total[$__rate_interval]))",
          "legendFormat": "{{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Cost by Token Type · calc",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (label_replace(increase(claude_code_claude_code_token_usage_tokens_total[$__rate_interval]),\"model\",\"$1\",\"model\",\"^(claude-[^[]+).*$\") * on(model,type) group_left() claude_token_price_usd_per_mtok) / 1e6",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 23,
      "title": "Token Price Table (USD/MTok)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "options": {
        "sortBy": [
          {
            "displayName": "model"
          },
          {
            "displayName": "type"
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "model"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "Value #A": false
            },
            "renameByName": {
              "Value #A": "price (USD/MTok)"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "claude_token_price_usd_per_mtok",
          "legendFormat": "",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table"
        }
      ]
    },
    {
      "id": 24,
      "title": "Cost · calc",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(label_replace(increase(claude_code_claude_code_token_usage_tokens_total[$__range]),\"model\",\"$1\",\"model\",\"^(claude-[^[]+).*$\") * on(model,type) group_left() claude_token_price_usd_per_mtok) / 1e6",
          "legendFormat": "Calculated Cost",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 25,
      "title": "Cost by Type · calc",
      "type": "piechart",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "options": {
        "pieType": "donut",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (label_replace(increase(claude_code_claude_code_token_usage_tokens_total[$__range]),\"model\",\"$1\",\"model\",\"^(claude-[^[]+).*$\") * on(model,type) group_left() claude_token_price_usd_per_mtok) / 1e6",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 26,
      "title": "Cost by Model · calc",
      "type": "piechart",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "options": {
        "pieType": "donut",
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (label_replace(increase(claude_code_claude_code_token_usage_tokens_total[$__range]),\"model\",\"$1\",\"model\",\"^(claude-[^[]+).*$\") * on(model,type) group_left() claude_token_price_usd_per_mtok) / 1e6",
          "legendFormat": "{{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0
      }
    ]
  }
}
